{
  "version": 2,
  "routes": [
    {
      "src": "/api/exchange/(.*)",
      "dest": "/api/exchange.js"
    },
    {
      "src": "/api/exchange",
      "dest": "/api/exchange.js"
    },
    {
      "src": "/api/expenses/(.*)",
      "dest": "/api/expenses.js"
    },
    {
      "src": "/api/expenses",
      "dest": "/api/expenses.js"
    },
    {
      "src": "/api/files/(.*)",
      "dest": "/api/files.js"
    },
    {
      "src": "/api/files",
      "dest": "/api/files.js"
    },
    {
      "src": "/api/checklists/(.*)",
      "dest": "/api/checklists.js"
    },
    {
      "src": "/api/checklists",
      "dest": "/api/checklists.js"
    },
    {
      "src": "/api/upload",
      "dest": "/api/upload.js"
    },
    {
      "src": "/markdown-files/(.*)",
      "dest": "/frontend/public/markdown-files/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/public/$1"
    }
  ],
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/public"
}