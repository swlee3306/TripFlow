{
  "version": 2,
  "routes": [
    {
      "src": "/api/exchange/rates",
      "dest": "/api/exchange/rates.js"
    },
    {
      "src": "/api/exchange/convert",
      "dest": "/api/exchange/convert.js"
    },
    {
      "src": "/api/expenses",
      "dest": "/api/expenses/index.js"
    },
    {
      "src": "/api/expenses/budget",
      "dest": "/api/expenses/budget.js"
    },
    {
      "src": "/api/expenses/stats",
      "dest": "/api/expenses/stats.js"
    },
    {
      "src": "/api/files",
      "dest": "/api/files/index.js"
    },
    {
      "src": "/api/expenses/([^/]+)",
      "dest": "/api/expenses/[id].js"
    },
    {
      "src": "/markdown-files/(.*)",
      "dest": "/frontend/public/markdown-files/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/public/$1"
    }
  ],
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/public"
}